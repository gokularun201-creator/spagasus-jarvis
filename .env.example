[TEMPLATE]
# ============================================================
# SPAGASUS JARVIS - environment configuration
# Copy this file to .env and fill in what you need.
# Never commit your real .env.
# ============================================================

# --- server -------------------------------------------------
HOST=0.0.0.0
PORT=8790

# --- lifecycle ----------------------------------------------
# Default: closing the dashboard leaves JARVIS running in the background
# (localhost keeps answering, wake word stays armed). Set EXIT_ON_CLOSE=1
# to shut the whole app down when the dashboard window closes.
EXIT_ON_CLOSE=0

# --- security -----------------------------------------------
# Token the mobile companion needs to pair. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PHONE_TOKEN=spagasus-local-dev-token

# Optional: lock screen PIN, used ONLY as a fallback in unlock_phone() when
# dismiss-keyguard can't clear a PIN-secured lock screen. Leave blank to
# keep the old wake+dismiss-only behavior with no PIN entry.
PHONE_UNLOCK_PIN=

# --- AI adapters (optional - runs without them) --------------
# OpenAI-compatible chat completions (tool-calling capable)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Vision: JARVIS POSTs screenshot PNG (base64 JSON) here for screen
# understanding. Expects {"description": "..."} in the response.
VISION_API_URL=

# --- speech ---------------------------------------------------
# google = raw-PCM Google speech API (default, no setup)
# whisper = local OpenAI Whisper (pip install openai-whisper + model download)
STT_ENGINE=google
WHISPER_MODEL=base

# edge-tts neural voice (natural). List voices with:
#   python -m edge_tts --list-voices
TTS_VOICE=en-US-ChristopherNeural

# Real-time noise cancellation on the mic (default ON): background noise is
# gated out so only your voice reaches speech recognition. Set NOISE_CANCEL=0
# to disable.
NOISE_CANCEL=1
